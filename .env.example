# Kenotic / Reconstruct environment configuration
# Copy to .env and fill in your values.

# Database path (default: ~/.kenotic/memory.db)
# KENOTIC_DB_PATH=~/.kenotic/memory.db

# MCP server auth token (leave empty for localhost-only, no auth)
# KENOTIC_MCP_TOKEN=your-secret-token-here

# GPU device for embeddings (default: cuda if available, else cpu)
# RAYA_EMBED_DEVICE=cuda

# CUDA device selection (if multiple GPUs)
# CUDA_VISIBLE_DEVICES=0

# Hugging Face cache directory
# TRANSFORMERS_CACHE=~/.cache/huggingface
